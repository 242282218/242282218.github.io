---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  limit?: number;
}

const { posts, limit } = Astro.props;
const visiblePosts = limit === undefined ? posts : posts.slice(0, limit);
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(date);
---
{visiblePosts.length === 0 ? (
  <p class="empty-state">还没有公开的记录。写下第一篇后，它会出现在这里。</p>
) : (
  <div>
    {visiblePosts.map((post) => (
      <a class="entry" href={`/blog/${post.id}/`}>
        <span class="meta">{formatDate(post.data.pubDate)}{post.data.tags.length > 0 && `　·　${post.data.tags.join(' / ')}`}</span>
        <h3>{post.data.title}</h3>
        <p>{post.data.description}</p>
      </a>
    ))}
  </div>
)}
