---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(post.data.pubDate);
---
<BaseLayout title={`${post.data.title} · 观澜志`} description={post.data.description}>
  <div class="shell">
    <article class="article">
      <header class="article-header">
        <p class="post-meta">{date}{post.data.tags.length > 0 && `　·　${post.data.tags.join(' / ')}`}</p>
        <h1>{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
      <a class="back-link" href="/blog/">← 返回全部文章</a>
    </article>
  </div>
</BaseLayout>
