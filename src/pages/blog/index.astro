---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts(await getCollection('blog'));
---
<BaseLayout title="学习记录 · 观澜志" description="观澜整理的学习记录。">
  <div class="shell">
    <header class="page-intro"><p class="eyebrow">学习记录</p><h1>写下学习的过程。</h1><p>遇到的问题、做过的尝试，以及当时的想法，都放在这里。</p></header>
    <div class="list-page"><PostList posts={posts} /></div>
  </div>
</BaseLayout>
