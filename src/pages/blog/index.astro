---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/posts';

const posts = publishedPosts(await getCollection('blog'));
---
<BaseLayout title="文章 · 242282218" description="242282218 的技术文章与学习笔记。">
  <div class="shell">
    <header class="page-intro"><p class="eyebrow">技术文章 · 学习笔记</p><h1>写下过程，也留下答案。</h1><p>这里会记录项目实践、技术问题和学习中的思考。文章将持续更新。</p></header>
    <div class="list-page"><PostList posts={posts} /></div>
  </div>
</BaseLayout>
