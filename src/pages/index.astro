---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPosts } from '../lib/posts';

const posts = publishedPosts(await getCollection('blog'));
---
<BaseLayout title="242282218 · 技术手记" description="242282218 的个人主页与技术博客，记录项目实践和学习过程。">
  <div class="shell">
    <section class="home-hero" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">个人主页 · 技术博客</p>
        <h1 id="home-title">写代码，<br />也把<strong>想明白的事</strong><br />写下来。</h1>
        <p class="lead">这里是 242282218 的技术手记。记录做过的项目、遇到的问题，以及仍在继续的学习。</p>
        <div class="hero-actions">
          <a class="primary-link" href="/projects/">看我的项目 ↗</a>
          <a class="text-link" href="/blog/">阅读文章 ↗</a>
        </div>
      </div>
      <aside class="hero-aside">
        <span class="eyebrow">关于这个站点</span>
        <h2>让作品与学习记录，<br />都有自己的位置。</h2>
        <p>项目呈现实际完成的工作；文章留下值得再次查阅的思考。内容会随着实践逐步积累。</p>
      </aside>
    </section>
    <section class="home-section" aria-labelledby="projects-title">
      <div class="section-label"><h2 id="projects-title">项目</h2><p>从想法到实现，<br />留待真实作品补充。</p></div>
      <div><p class="empty-state">项目介绍正在整理。你可以先访问 <a class="text-link" href="https://github.com/242282218">GitHub 主页 ↗</a> 查看公开仓库。</p></div>
    </section>
    <section class="home-section" aria-labelledby="writing-title">
      <div class="section-label"><h2 id="writing-title">最近写下的</h2><p>从一次实践开始，<br />记录能复用的经验。</p></div>
      <div><div class="section-heading"><span></span><a href="/blog/">全部文章 ↗</a></div><PostList posts={posts} limit={3} /></div>
    </section>
  </div>
</BaseLayout>
