---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedPosts } from '../lib/posts';

const posts = publishedPosts(await getCollection('blog'));
---
<BaseLayout title="观澜志 · 观澜的学习记录" description="观澜的学习记录，整理遇到的问题、做过的尝试和当时的想法。">
  <div class="shell">
    <section class="home-hero" aria-labelledby="home-title">
      <p class="eyebrow">观澜 · 学习记录</p>
      <h1 id="home-title">边学，边记。</h1>
      <p class="lead">你好，我是观澜。这里整理学习时遇到的问题、做过的尝试和当时的想法。</p>
      <a class="text-link hero-link" href="/blog/">查看记录 ↗</a>
    </section>
    <section class="home-section" aria-labelledby="writing-title">
      <div class="section-label"><h2 id="writing-title">最近的记录</h2><p>一些学习过程，慢慢整理。</p></div>
      <div><div class="section-heading"><a href="/blog/">全部记录 ↗</a></div><PostList posts={posts} limit={3} /></div>
    </section>
    <section class="home-section" aria-labelledby="projects-title">
      <div class="section-label"><h2 id="projects-title">项目</h2><p>整理好的项目会放在这里。</p></div>
      <div><p class="empty-state">目前还没有整理好的项目介绍。公开代码可以在 <a class="text-link" href="https://github.com/guanlangzg">GitHub ↗</a> 查看。</p></div>
    </section>
  </div>
</BaseLayout>
